# Docker Environment Variables
# Copy this to .env and configure

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,*.example.com

# Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=library_db
DB_USER=library_user
DB_PASSWORD=library_pass
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=root_pass

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@library-saas.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://example.com

# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_STRIPE_KEY=pk_test_your_key_here

# Redis (Cache)
REDIS_URL=redis://redis:6379/0

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=86400
